# Set these only in Vercel Environment Variables or local .env.local.
# Never prefix secrets with VITE_, NEXT_PUBLIC_, or PUBLIC_.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-sol

# A private study code shared only with the people you want to admit.
# At least 16 characters. This protects AI requests, not local browser data.
HESABU_ACCESS_CODE=REPLACE_WITH_A_LONG_PRIVATE_STUDY_CODE

# At least 32 characters. Generate your own with: npm run secret
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS

# Optional: distributed limits across serverless instances.
# Both values are required to enable Redis limits.
# UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_YOUR_DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_REDIS_REST_TOKEN

# Local development port only.
# PORT=3000
